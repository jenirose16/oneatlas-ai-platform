# ==============================================================================
# OneAtlas - Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your actual configuration.
# DO NOT commit real secrets or credentials to version control.

# PostgreSQL Database Connection String
# Format: postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
#
# Examples:
# - Local PostgreSQL:   postgresql://postgres:postgres@localhost:5432/oneatlas_db?schema=public
# - Hosted Neon:        postgresql://neondb_owner:npg_xyz@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# - Hosted Supabase:    postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oneatlas_db?schema=public"

# Node Environment ("development" | "production" | "test")
NODE_ENV="development"
